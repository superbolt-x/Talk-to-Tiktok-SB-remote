# ── TikTok Business API (shared team credential) ─────────────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
# Optional: default advertiser account so users don't have to switch every time
TIKTOK_ADVERTISER_ID=

# ── Remote HTTP server settings ──────────────────────────────────────────────
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Public Railway URL (no trailing slash, no /mcp). Needed to pin the Host header.
SERVER_URL=https://your-service.up.railway.app

# ── Authless / Parker-style gate (OPTIONAL) ──────────────────────────────────
# Leave EMPTY to run fully open (anyone with the URL can connect).
# If set, every MCP request must carry this token, supplied via the connector URL
#   https://your-service.up.railway.app/mcp?access_token=THIS_TOKEN
# or an Authorization: Bearer THIS_TOKEN header.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUTH_TOKEN=
